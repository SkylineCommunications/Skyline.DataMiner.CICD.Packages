<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>{B1111111-1111-1111-1111-111111111111}</SharedGUID>
  </PropertyGroup>

  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>RecursiveSharedProjectReference.Shared</Import_RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)SharedMarker.cs" />
  </ItemGroup>

</Project>