<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <DisableMSBuildAssemblyCopyCheck Condition="'$(TargetFramework)' == 'net48'">true</DisableMSBuildAssemblyCopyCheck>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" />
    <PackageReference Include="XMLUnit.Core" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <!-- Core MSBuild supplies NuGet.Frameworks; net48 must load the version required by NuGet.Packaging. -->
    <PackageReference Include="NuGet.Frameworks" Condition="'$(TargetFramework)' != 'net48'" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="NuGet.Frameworks" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Assemblers.Automation\Assemblers.Automation.csproj" />
    <ProjectReference Include="..\TestHelpers\TestHelpers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TestFiles\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestFiles\**" Exclude="TestFiles\**\obj\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>



  <ItemGroup>
    <!-- Ensures the SDK NuGet package is in the cache for test project evaluation -->
    <PackageDownload Include="Skyline.DataMiner.Sdk" Version="[2.5.9-sdmfix20261005.1]" />
    <PackageDownload Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="[1.0.3]" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)\microsoft.netframework.referenceassemblies.net48\1.0.3\build\.NETFramework\v4.8\mscorlib.dll"
             Link="ReferenceAssemblies\net48\mscorlib.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>